# Αντέγραψε αυτό το αρχείο σε .env και συμπλήρωσε τα κλειδιά
# cp .env.example .env

# Gemini API key (προτιμάται όταν υπάρχει)
# Δημιούργησε κλειδί στο Google AI Studio: https://aistudio.google.com/apikey
GCP_API_KEY=

# OpenRouter API key (fallback για LLM)
# Δωρεάν λογαριασμός: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-PUT_YOUR_KEY_HERE

# Local fallback μέσω Ollama (χρησιμοποιείται όταν δεν υπάρχει OpenRouter key)
# Εγκατάστησε Ollama και κατέβασε: ollama pull qwen2.5-coder:7b και ollama pull llama3.1:8b
NOUS_LOCAL_LLM=1
NOUS_LOCAL_LLM_URL=http://127.0.0.1:11434
NOUS_LOCAL_CODING_MODEL=qwen2.5-coder:7b
NOUS_LOCAL_GENERAL_MODEL=llama3.1:8b
NOUS_LOCAL_LLM_TIMEOUT=120

# Master token για το API (απαραίτητο σε κάθε remote/public deploy)
# Δημιούργησε τυχαίο: python -c "import secrets;print(secrets.token_urlsafe(32))"
NOUS_TOKEN=

# Μόνο για τοπικές δοκιμές: 1 = καθόλου auth. ΜΗΝ το βάζεις σε public deploy.
NOUS_ALLOW_ANONYMOUS=

# Remote tunnel (προαιρετικό)
NGROK_AUTHTOKEN=
