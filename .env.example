# Αντέγραψε αυτό το αρχείο σε .env και συμπλήρωσε τα κλειδιά
# cp .env.example .env

# OpenRouter API key (απαραίτητο για LLM)
# Δωρεάν λογαριασμός: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-PUT_YOUR_KEY_HERE

# Master token για το API (απαραίτητο σε κάθε remote/public deploy)
# Δημιούργησε τυχαίο: python -c "import secrets;print(secrets.token_urlsafe(32))"
NOUS_TOKEN=

# Μόνο για τοπικές δοκιμές: 1 = καθόλου auth. ΜΗΝ το βάζεις σε public deploy.
NOUS_ALLOW_ANONYMOUS=

# Remote tunnel (προαιρετικό)
NGROK_AUTHTOKEN=
